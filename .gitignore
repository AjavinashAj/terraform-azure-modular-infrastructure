# Terraform working directories
**/.terraform/*

# Terraform state files
*.tfstate
*.tfstate.*

# Terraform variable files - may contain sensitive values
*.tfvars
*.tfvars.json

# Terraform crash logs
crash.log
crash.*.log

# Sensitive files
*.pem
*.key

# VS Code
.vscode/

# Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json
